# ==============================================================================
# Sadeed Kamil Portfolio - Backend Email Configuration
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Recipient Email (Where you want client hire requests to be delivered)
RECIPIENT_EMAIL=sadeedkamil143@gmail.com

# SMTP Server Settings (Example: Gmail, Outlook, or Custom SMTP)
# For Gmail: Use an App Password (not your regular account password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sadeedkamil143@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Sender Details shown in received email
SENDER_NAME="Sadeed Portfolio System"
SENDER_EMAIL=noreply@sadeed.dev
